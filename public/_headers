# Response headers, for a host that can actually set them.
#
# WHERE THIS IS READ
#   `_headers` is a Cloudflare Pages and Netlify convention. GitHub Pages ignores
#   this file completely, so today none of it is live.
#   If GitHub Pages stays the origin and Cloudflare is only a proxy in front of
#   it, this file is still NOT read: replicate the same values as a Cloudflare
#   Transform Rule or in a Worker instead. See docs/deployment-headers.md.
#
# WHY IT EXISTS
#   Two required spec items — x-content-type-options and frame-ancestors — cannot
#   be satisfied on GitHub Pages at all, because it offers no way to set response
#   headers. Every response also carries Pages' fixed max-age=600, including
#   content-hashed assets that should be immutable for a year.
#
# COMMENT RULE
#   Comments are only comments at the top level, at column 0, on their own line.
#   A `#` line indented inside a block is parsed as a header and can invalidate
#   the block, so keep every block to header lines only.
#
# CONTENT-SECURITY-POLICY
#   Enabled: frame-ancestors, base-uri, object-src. These three cannot break
#   rendering under any circumstance.
#   Held back: the full policy. index.html inlines a <style> block and a JSON-LD
#   data block, and whether `script-src 'self'` blocks that data block is a
#   question for a real browser and the Rich Results Test, not for a build step.
#   To enable it, add this one line inside the `/*` block below:
#     Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
#
# HSTS
#   includeSubDomains is set. preload is deliberately not: the spec's own hsts
#   page argues against preloading, and removal from the preload list is slow.
#
# PERMISSIONS-POLICY
#   Everything the site cannot use is closed. `autoplay` and `fullscreen` are
#   left allowed on purpose: nothing uses either yet, and denying them would
#   quietly break a video hero if one is ever added.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), usb=(), xr-spatial-tracking=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  Link: </llms.txt>; rel="describedby"; type="text/markdown"; title="Site index for LLMs", </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json", </sitemap.xml>; rel="sitemap"; type="application/xml", </feed.xml>; rel="alternate"; type="application/rss+xml"; title="Selected work"

# Vite fingerprints everything under /assets with a content hash, so the body can
# never change for a given URL. Cache it for a year and never revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is not fingerprinted: always revalidate, and let the ETag make it cheap.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Unhashed assets and documents: fresh for an hour, stale served while
# revalidating, so a replaced file shows up without a hard refresh.
/images/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/documents/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/environments/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# GitHub Pages serves extensionless files as application/octet-stream, which
# breaks parsers that key off the type. Pin the correct types.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

# GitHub Pages already gets these two right (text/plain and manifest+json), but
# it serves feed.xml as application/xml. Every reader accepts that; this pins the
# registered type so the proxy path is exact.
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600